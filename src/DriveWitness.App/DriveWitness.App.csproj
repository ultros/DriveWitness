<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DriveWitness</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/drivewitness.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DriveWitness.Core/DriveWitness.Core.csproj" />
    <EmbeddedResource Include="Assets/drivewitness.ico" LogicalName="DriveWitness.Icon" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="DriveWitness.License" />
    <EmbeddedResource Include="../../STORE_EULA.txt" LogicalName="DriveWitness.StoreEula" />
    <EmbeddedResource Include="../../PRIVACY.md" LogicalName="DriveWitness.Privacy" />
    <EmbeddedResource Include="../../THIRD_PARTY_NOTICES.md" LogicalName="DriveWitness.ThirdParty" />
    <EmbeddedResource Include="../../licenses/*" LogicalName="DriveWitness.Legal.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
